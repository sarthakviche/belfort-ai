# Copy this file to .env and fill in the values. Never share or commit .env.

# Google Gemini key for the Ask chat (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: which Gemini model to call
# GEMINI_MODEL=gemini-flash-latest

# Optional: comma-separated access codes; when set, every user must enter one
# ACCESS_CODES=
